RAG_LLM_PROVIDER=mock
OLLAMA_MODEL=qwen3:8b-q4_K_M
OLLAMA_URL=http://localhost:11434

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_document_intelligence
POSTGRES_USER=ai_document_app
POSTGRES_PASSWORD=replace_with_your_local_database_password

# Email / SMTP Configuration
# Leave SMTP_HOST empty to disable email delivery locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=AI Document Intelligence Assistant
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Private Document Storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
SANITIZED_DIR=data/private_storage/sanitized
MAX_FILE_SIZE_MB=50


# Redis / Background Processing
# Local development Redis. Production must use rediss:// with ACL credentials.
REDIS_URL=redis://127.0.0.1:6379/0
